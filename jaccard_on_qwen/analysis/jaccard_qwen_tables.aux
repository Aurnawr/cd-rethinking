\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces BPE-token Jaccard similarity between APC (direct sampling + Adaptive Plausibility Constraint) and Greedy Search on LLaVA-Bench (In-the-Wild), evaluated on Qwen2.5-VL-7B. Jaccard scores are computed over sets of unique BPE token IDs using the Qwen2 tiktoken tokenizer (vocabulary size 151{,}643) and averaged across all 60 questions. Text is normalised before tokenisation to remove markdown artefacts (\texttt  {**bold**}, headers, bullets) introduced by the model despite a no-formatting system prompt. Higher values indicate greater overlap with greedy search.}}{1}{}\protected@file@percent }
\newlabel{tab:qwen_jaccard_apc_greedy}{{1}{1}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces BPE-token Jaccard similarity of APC outputs against Greedy Search and Direct Sampling at four representative $\beta $ values, evaluated on Qwen2.5-VL-7B across 60 LLaVA-Bench (In-the-Wild) questions. Tokenisation uses the Qwen2 tiktoken tokenizer (vocabulary size 151{,}643). In every case, APC outputs are more similar to Greedy Search than to Direct Sampling, showing that even at low $\beta $, APC pulls the output distribution towards greedy rather than preserving the diversity of direct sampling.}}{2}{}\protected@file@percent }
\newlabel{tab:qwen_jaccard_apc_greedy_vs_sample}{{2}{2}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces BPE-token Jaccard similarity between VCD (Visual Contrastive Decoding) outputs and three reference conditions --- Greedy Search, APC at its default $\beta {=}0.1$, and Direct Sampling --- evaluated on Qwen2.5-VL-7B across 42 LLaVA-Bench (In-the-Wild) questions (42 of 60 completed). Tokenisation uses the Qwen2 tiktoken tokenizer (vocabulary size 151{,}643).}}{2}{}\protected@file@percent }
\newlabel{tab:qwen_jaccard_vcd}{{3}{2}{}{}{}}
